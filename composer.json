{
    "name": "league/route",
    "description": "Fast routing and dispatch component including PSR-15 middleware, built on top of FastRoute.",
    "keywords": [
        "league",
        "route",
        "router",
        "dispatcher",
        "psr-7",
        "psr7",
        "psr-15",
        "psr15"
    ],
    "homepage": "https://github.com/thephpleague/route",
    "license": "MIT",
    "authors": [
        {
            "name": "Phil Bennett",
            "email": "mail@philbennett.co.uk",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.3",
        "nikic/fast-route": "^1.3",
        "psr/container": "^2.0",
        "psr/http-factory": "^1.0",
        "psr/http-message": "^2.0",
        "psr/http-server-handler": "^1.0.1",
        "psr/http-server-middleware": "^1.0.1",
        "psr/simple-cache": "^3.0"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.0",
        "laminas/laminas-diactoros": "^3.5",
        "mockery/mockery": "^1.6",
        "pestphp/pest": "^4.0",
        "phpstan/phpstan": "^1.12",
        "roave/security-advisories": "dev-latest"
    },
    "suggest": {
        "laravel/serializable-closure": "Required if you need to serialise closures independently"
    },
    "replace": {
        "orno/route": "~1.0",
        "orno/http": "~1.0"
    },
    "autoload": {
        "psr-4": {
            "League\\Route\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "League\\Route\\Test\\": "tests"
        },
        "files": ["tests/Fixture/function.php"]
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        },
        "sort-packages": true
    },
    "extra": {
        "branch-alias": {
            "dev-master": "7.x-dev",
            "dev-7.x": "7.x-dev",
            "dev-6.x": "6.x-dev",
            "dev-5.x": "5.x-dev",
            "dev-4.x": "4.x-dev",
            "dev-3.x": "3.x-dev",
            "dev-2.x": "2.x-dev",
            "dev-1.x": "1.x-dev"
        }
    },
    "scripts": {
        "test": ["@test:unit", "@test:types", "@test:style"],
        "test:unit": "vendor/bin/pest",
        "test:types": "vendor/bin/phpstan analyse --no-progress",
        "test:style": "vendor/bin/php-cs-fixer fix --dry-run --diff"
    }
}
